<div class="col-lmd-6 offset-md-3 col-xl-4 offset-xl-4 text-center">
    <h3 class="mb-3">Belépés</h3>

    <% if (error) { %>
        <div class="alert alert-primary d-flex align-items-center" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" class="bi flex-shrink-0 me-2" viewBox="0 0 16 16" role="img" aria-label="Warning:">
                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
            </svg>
            <div>
                <%= error%>
            </div>
        </div>


    <% } %>
    <form action="/main" method="get">
        <div class="form-floating mb-3">
        <input type="text" class="form-control" id="nickname" name="nickname" placeholder="" value="<%= nickname %>">
        <label for="nickname">Név</label>
        </div>
        <div class="form-floating mb-3">
        <select class="form-select" id="rooms" name="room" aria-label="">
            <option value="" selected>Válassz...</option>
            <% rooms.forEach(item=>{ %>
                <option value="<%= item.id %>"
                    <%= item.id == room ? 'selected' : '""' %>
                    >
                    <%= item.label %> </option>
            <%}) %>
        </select>
        <label for="room">Csevegőszoba szoba</label>
        </div>
        <button class="btn btn-primary mb-3">Belépés a csevegőbe</button>
    </form>
</div>